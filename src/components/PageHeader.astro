---
// Titolo e sottotitolo in cima alle pagine interne
interface Props {
	titolo: string;
	sottotitolo?: string;
}
const { titolo, sottotitolo } = Astro.props;
---

<header class="mx-auto max-w-5xl px-4 pt-16 pb-10 sm:px-6 md:pt-24">
	<h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{titolo}</h1>
	{sottotitolo && <p class="mt-4 max-w-2xl text-lg text-slate-300">{sottotitolo}</p>}
</header>
