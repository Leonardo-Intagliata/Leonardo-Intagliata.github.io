---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Icona from '../components/Icona.astro';
import { navigazione } from '../data/profilo';

// Le pagine da mostrare nella home (tutte tranne la home stessa)
const pagine = navigazione.filter((voce) => voce.href !== '/');
---

<Layout>
	<main>
		<Hero />

		<!-- Esplora: scorciatoie verso le altre pagine -->
		<section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6">
			<h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Esplora</h2>
			<div class="mt-6 grid gap-4 sm:grid-cols-2">
				{
					pagine.map((p) => (
						<a href={p.href} class="group flex gap-4 rounded-xl border border-slate-800 bg-slate-900/70 p-6 backdrop-blur-sm transition-colors hover:border-blue-500/60">
							<Icona tracciati={p.icona} class="h-7 w-7 shrink-0 text-blue-400" />
							<div>
								<h3 class="font-semibold">{p.label} <span class="inline-block transition-transform group-hover:translate-x-1">→</span></h3>
								<p class="mt-1 text-slate-300">{p.descrizione}</p>
							</div>
						</a>
					))
				}
			</div>
		</section>
	</main>
</Layout>
