---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { profilo } from '../data/profilo';

// Progetti: aggiungine uno copiando un blocco { ... }
// stato: 'In sviluppo' | 'Completato' | 'In programma' | 'Privato'
const progetti = [
	{
		titolo: 'Sito portfolio personale',
		stato: 'Completato',
		descrizione:
			'Il sito che stai guardando: responsive, veloce e pubblicato su GitHub Pages con deploy automatico a ogni modifica.',
		tecnologie: ['Astro', 'Tailwind CSS', 'GitHub Actions', 'GitHub Pages'],
		link: [{ testo: 'Codice su GitHub', href: 'https://github.com/Leonardo-Intagliata/Leonardo-Intagliata.github.io' }],
	},
	{
		titolo: 'Prossimo progetto: applicazione su Azure',
		stato: 'In programma',
		descrizione:
			'Una piccola applicazione web con database gestito, pubblicata su Microsoft Azure con infrastruttura descritta in codice e pipeline CI/CD.',
		tecnologie: ['Azure', 'Python', 'CI/CD'],
		link: [],
	},
	{
		titolo: 'Progetto di analisi dei mercati finanziari',
		stato: 'Privato',
		descrizione:
			'Progetto personale in Python sull\'analisi di dati finanziari. Il codice non è pubblico: ne parlo volentieri a un colloquio.',
		tecnologie: ['Python', 'Analisi dati'],
		link: [],
	},
];

const coloreStato: Record<string, string> = {
	'In sviluppo': 'border-amber-400/30 bg-amber-950 text-amber-300',
	Completato: 'border-emerald-400/30 bg-emerald-950 text-emerald-300',
	'In programma': 'border-slate-500/40 bg-slate-800 text-slate-300',
	Privato: 'border-violet-400/30 bg-violet-950 text-violet-300',
};
---

<Layout title="Lavori · Leonardo Intagliata" description="I progetti di Leonardo Intagliata: Python, dati e cloud.">
	<main>
		<PageHeader titolo="Lavori" sottotitolo="I progetti che ho realizzato e quelli che sto sviluppando." />

		<section class="mx-auto grid max-w-5xl gap-6 px-4 pb-16 sm:px-6 md:grid-cols-2">
			{
				progetti.map((p) => (
					<article
						class:list={[
							'flex flex-col rounded-xl border p-6 backdrop-blur-sm',
							p.stato === 'In programma'
								? 'border-dashed border-slate-700 bg-slate-900/40'
								: 'border-slate-800 bg-slate-900/70',
						]}
					>
						<span class:list={['w-fit rounded-full border px-3 py-0.5 text-xs font-medium', coloreStato[p.stato]]}>
							{p.stato}
						</span>
						<h2 class="mt-4 text-xl font-semibold">{p.titolo}</h2>
						<p class="mt-3 flex-1 leading-relaxed text-slate-300">{p.descrizione}</p>
						<ul class="mt-5 flex flex-wrap gap-2">
							{p.tecnologie.map((t) => (
								<li class="rounded-md bg-slate-800 px-2.5 py-1 text-xs font-medium text-slate-200">{t}</li>
							))}
						</ul>
						{p.link.length > 0 && (
							<div class="mt-5 flex gap-4 text-sm font-semibold">
								{p.link.map((l) => (
									<a href={l.href} target="_blank" rel="noopener" class="text-blue-400 hover:underline">
										{l.testo} →
									</a>
								))}
							</div>
						)}
					</article>
				))
			}
		</section>
	</main>
</Layout>
